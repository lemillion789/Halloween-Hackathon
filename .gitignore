# entorno y binarios pesados (se regeneran / se descargan aparte)
CAD/.venv/
vision/.venv/
__pycache__/
tools/
*.AppImage
# build de arduino-cli, si se crea dentro del proyecto
build/

# pesos de YOLO (se descargan solos) y log de pruebas
vision/*.pt
vision/*.jsonl
vision/test_images/*_out.jpg
vision/ruleta_elegido_*.jpg
vision/test_sounds/
vision/*.wav

# entorno de schematics, builds de arduino-cli del hoverboard y el clon del firmware (repo aparte con .git propio)
schematics/.venv/
Hoverboard/*/build/
Hoverboard/firmware_src/*
!Hoverboard/firmware_src/*.bin
